{
  "$description": "Dhanush Design System tokens (source of truth). Values like \"{color.brand.600}\" are references. Authored by Dhanush.",
  "primitive": {
    "color": {
      "brand": {
        "50": "#eef2ff",
        "100": "#e0e7ff",
        "200": "#c7d2fe",
        "300": "#a5b4fc",
        "400": "#818cf8",
        "500": "#6366f1",
        "600": "#4f46e5",
        "700": "#4338ca",
        "800": "#3730a3"
      },
      "neutral": {
        "0": "#ffffff",
        "50": "#f8fafc",
        "100": "#f1f5f9",
        "200": "#e2e8f0",
        "300": "#cbd5e1",
        "400": "#94a3b8",
        "500": "#64748b",
        "600": "#475569",
        "700": "#334155",
        "800": "#1e293b",
        "900": "#0f172a",
        "950": "#0b1220"
      },
      "green": { "100": "#dcfce7", "700": "#15803d", "800": "#166534" },
      "amber": { "100": "#fef3c7", "700": "#b45309", "800": "#92400e" },
      "red": { "100": "#fee2e2", "300": "#fca5a5", "700": "#b91c1c", "800": "#991b1b" },
      "sky": { "100": "#e0f2fe", "700": "#0369a1", "800": "#075985" }
    },
    "space": {
      "0": "0px",
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "5": "20px",
      "6": "24px",
      "8": "32px",
      "10": "40px",
      "12": "48px",
      "16": "64px"
    },
    "radius": {
      "none": "0px",
      "sm": "4px",
      "md": "8px",
      "lg": "12px",
      "xl": "16px",
      "full": "9999px"
    },
    "font": {
      "family": {
        "sans": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
        "mono": "ui-monospace, SFMono-Regular, Menlo, monospace"
      },
      "size": {
        "xs": "12px",
        "sm": "14px",
        "md": "16px",
        "lg": "18px",
        "xl": "20px",
        "2xl": "24px",
        "3xl": "30px"
      },
      "weight": { "regular": "400", "medium": "500", "semibold": "600", "bold": "700" },
      "lineHeight": { "tight": "1.2", "normal": "1.5" }
    },
    "shadow": {
      "sm": "0 1px 2px rgb(15 23 42 / 0.06)",
      "md": "0 4px 12px rgb(15 23 42 / 0.08)",
      "lg": "0 12px 32px rgb(15 23 42 / 0.12)"
    },
    "motion": {
      "duration": { "fast": "120ms", "normal": "180ms" },
      "easing": { "standard": "cubic-bezier(0.2, 0, 0, 1)" }
    }
  },
  "theme": {
    "light": {
      "color": {
        "canvas": "{color.neutral.50}",
        "surface": "{color.neutral.0}",
        "border": "{color.neutral.200}",
        "border-control": "{color.neutral.500}",
        "text": "{color.neutral.900}",
        "text-muted": "{color.neutral.500}",
        "text-on-action": "{color.neutral.0}",
        "action": "{color.brand.600}",
        "action-hover": "{color.brand.700}",
        "focus-ring": "{color.brand.500}",
        "danger-action": "{color.red.700}",
        "danger-action-hover": "{color.red.800}",
        "danger-text": "{color.red.700}",
        "neutral-bg": "{color.neutral.100}",
        "neutral-fg": "{color.neutral.700}",
        "info-bg": "{color.sky.100}",
        "info-fg": "{color.sky.800}",
        "success-bg": "{color.green.100}",
        "success-fg": "{color.green.800}",
        "warning-bg": "{color.amber.100}",
        "warning-fg": "{color.amber.800}",
        "danger-bg": "{color.red.100}",
        "danger-fg": "{color.red.800}"
      }
    },
    "dark": {
      "color": {
        "canvas": "{color.neutral.950}",
        "surface": "{color.neutral.900}",
        "border": "{color.neutral.700}",
        "border-control": "{color.neutral.400}",
        "text": "{color.neutral.50}",
        "text-muted": "{color.neutral.400}",
        "text-on-action": "{color.neutral.0}",
        "action": "{color.brand.600}",
        "action-hover": "{color.brand.700}",
        "focus-ring": "{color.brand.400}",
        "danger-action": "{color.red.700}",
        "danger-action-hover": "{color.red.800}",
        "danger-text": "{color.red.300}",
        "neutral-bg": "{color.neutral.800}",
        "neutral-fg": "{color.neutral.200}",
        "info-bg": "{color.sky.800}",
        "info-fg": "{color.sky.100}",
        "success-bg": "{color.green.800}",
        "success-fg": "{color.green.100}",
        "warning-bg": "{color.amber.800}",
        "warning-fg": "{color.amber.100}",
        "danger-bg": "{color.red.800}",
        "danger-fg": "{color.red.100}"
      }
    }
  }
}
